{
  "name": "quest-touch-to-wii-emulation",
  "version": "1.0.0",
  "private": true,
  "description": "Use Meta Quest Touch controllers as Dolphin Wii Remotes through a DSU (Cemuhook) bridge over SteamVR, written in Rust",
  "license": "Apache-2.0",
  "author": "Avi <avi6106@gmail.com>",
  "repository": "https://github.com/avi12/quest-touch-to-wii-emulation",
  "scripts": {
    "start": "cargo run --release -p bridge",
    "test": "cargo test --workspace",
    "lint": "avi12-lint",
    "lint:fix": "avi12-lint --fix",
    "lint:rust": "cargo clippy --workspace --all-targets -- -D warnings && cargo fmt --all --check"
  },
  "devDependencies": {
    "@ast-grep/cli": "^0.51.3",
    "ast-grep-rules-avi12": "github:avi12/lint-config#v0.11.0&path:/packages/ast-grep-rules",
    "avi12-lint": "github:avi12/lint-config#v0.11.0&path:/packages/avi12-lint",
    "oxfmt": "^0.78.0",
    "oxfmt-config-avi12": "github:avi12/lint-config#v0.11.0&path:/packages/oxfmt-config",
    "oxlint": "1.90.0",
    "oxlint-config-avi12": "github:avi12/lint-config#v0.11.0&path:/packages/oxlint-config",
    "rust-config-avi12": "github:avi12/lint-config#v0.11.0&path:/packages/rust-config"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.18.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.18.0"
}
